{
    "name": "@zyno-io/openapi-client-codegen",
    "version": "2.9.1",
    "description": "OpenAPI client generator for TypeScript apps",
    "license": "MIT",
    "author": {
        "name": "Zyno Consulting",
        "email": "support@zyno.io",
        "url": "https://zyno.io"
    },
    "repository": {
        "url": "https://github.com/zyno-io/openapi-client-codegen-ts"
    },
    "bin": {
        "generate-openapi-client": "./dist/esm/src/generator/cli.js"
    },
    "type": "module",
    "main": "./dist/cjs/src/client/index.cjs",
    "module": "./dist/esm/src/client/index.js",
    "browser": {
        "@hey-api/openapi-ts": false
    },
    "typings": "./dist/esm/src/client/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/src/client/index.d.ts",
            "import": "./dist/esm/src/client/index.js",
            "require": "./dist/cjs/src/client/index.cjs"
        },
        "./generator": {
            "types": "./dist/esm/src/generator/index.d.ts",
            "import": "./dist/esm/src/generator/index.js",
            "require": "./dist/esm/src/generator/index.js"
        }
    },
    "scripts": {
        "test": "tsx test/e2e/e2e.test.ts && tsx test/e2e/filter.test.ts",
        "test:typecheck": "tsx test/e2e/e2e.test.ts && tsx test/e2e/filter.test.ts && tsc -p tsconfig.test.json",
        "build": "./scripts/build.sh",
        "build:clean": "rm -rf dist && yarn build",
        "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
        "format": "oxfmt"
    },
    "dependencies": {
        "@hey-api/openapi-ts": "^0.99.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@tsconfig/node22": "*",
        "@types/node": "^26",
        "lefthook": "^2.1.10",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "ts-essentials": "^10.2.1",
        "tslib": "^2.8.1",
        "tsx": "^4.23.1",
        "type-fest": "^5.8.0",
        "typescript": "~6.0"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "packageManager": "yarn@4.18.0"
}
