{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["dom", "es2022"],
        "types": ["node"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*", "test/**/*"]
}
